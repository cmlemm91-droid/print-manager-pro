[Unit]
Description=PrintManager Pro - Auftragsverwaltung fuer 3D-Druck
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---------------------------------------------------------------------------
# Bitte anpassen: Benutzername und Projektordner (siehe README, Schritt 9)
# User          = Ergebnis von: whoami
# WorkingDirectory / ExecStart = Ergebnis von: pwd
# ---------------------------------------------------------------------------
User=pi
WorkingDirectory=/home/pi/print-manager
ExecStart=/home/pi/print-manager/.venv/bin/python main.py

Environment=PORT=8000
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
